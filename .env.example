# Environment Mode (development / test / production)
ENVIRONMENT=development
DEBUG=false

# Database Configuration
# Local SQLite zero-setup:
DATABASE_URL=sqlite+aiosqlite:///./aegis_gateway.db
# PostgreSQL for Docker / Production:
# DATABASE_URL=postgresql+asyncpg://aegis_user:aegis_secret_password@localhost:5432/aegis_db

# Redis Configuration (Optional in local mode; fallback to in-memory)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Security Secrets
ADMIN_API_KEY=aegis_admin_secret_super_secure_key_123
AUDIT_HMAC_SECRET=aegis_hmac_secret_for_audit_log_tamper_evidence

# LLM Provider Configuration
PROVIDER_MODE=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here
PROVIDER_TIMEOUT_SECONDS=30.0

# Rate Limiting & Risk Thresholds
DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_DAILY_TOKEN_BUDGET=100000
PROMPT_INJECTION_BLOCK_THRESHOLD=0.70
PROMPT_INJECTION_WARN_THRESHOLD=0.40
